{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:accord:jsonl:v1",
  "title": "Accord JSONL v1 line",
  "description": "Manifest must be first. UTF8 byte/depth/record limits, duplicate-key/identity checks, exact integer spellings and references/DAG are additionally enforced by the parser. This schema grants no authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "data": {
          "$ref": "#/$defs/task"
        }
      },
      "required": [
        "kind",
        "external_id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "epic"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "data": {
          "$ref": "#/$defs/epic"
        }
      },
      "required": [
        "kind",
        "external_id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "link"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "data": {
          "$ref": "#/$defs/link"
        }
      },
      "required": [
        "kind",
        "external_id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "note"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "data": {
          "$ref": "#/$defs/note"
        }
      },
      "required": [
        "kind",
        "external_id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "history"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "data": {
          "$ref": "#/$defs/history"
        }
      },
      "required": [
        "kind",
        "external_id",
        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "accord-jsonl"
        },
        "version": {
          "const": 1
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "high_water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "config_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "format",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "type": {
          "const": "task"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "created",
            "ready",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "owner": {
          "type": "string"
        },
        "requester": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "complexity": {
          "type": "string"
        },
        "areas": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "epic": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "epic"
                  ]
                },
                "external_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]+$"
                }
              },
              "required": [
                "kind",
                "external_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "commit": {
                  "type": "string"
                },
                "pr": {
                  "type": "string"
                },
                "run_summary": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                },
                "verified_commit": {
                  "type": "string"
                },
                "findings": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string"
                },
                "artifact": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "task"
                  ]
                },
                "external_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]+$"
                }
              },
              "required": [
                "kind",
                "external_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "title",
        "description",
        "role",
        "state",
        "priority"
      ],
      "additionalProperties": false
    },
    "epic": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "state": {
          "enum": [
            "open",
            "done",
            "cancelled"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "owner": {
          "type": "string"
        },
        "areas": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "description",
        "state",
        "priority"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "from": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "epic",
                "task"
              ]
            },
            "external_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "external_id"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "epic",
                "task"
              ]
            },
            "external_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "external_id"
          ],
          "additionalProperties": false
        },
        "type": {
          "enum": [
            "blocks",
            "contract_of",
            "spawned_by",
            "related",
            "duplicate_of"
          ]
        },
        "condition": {
          "enum": [
            "",
            "completed",
            "approved",
            "passed"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "epic": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "epic"
                  ]
                },
                "external_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]+$"
                }
              },
              "required": [
                "kind",
                "external_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "origin_ref": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "task",
                "epic",
                "link",
                "note"
              ]
            },
            "external_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "external_id"
          ],
          "additionalProperties": false
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "type": "string"
        },
        "origin_session_label": {
          "type": "string",
          "pattern": ":"
        },
        "tokens_spent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "commit": {
                  "type": "string"
                },
                "pr": {
                  "type": "string"
                },
                "run_summary": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                },
                "verified_commit": {
                  "type": "string"
                },
                "findings": {
                  "type": "string"
                },
                "verdict": {
                  "type": "string"
                },
                "artifact": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "source_state": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "config_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "origin_ref",
        "type",
        "at"
      ],
      "additionalProperties": false
    }
  }
}
