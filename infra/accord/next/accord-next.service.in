[Unit]
Description=Accord Next.js user interface
After=network.target accord.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=accord-next
Group=accord-next
WorkingDirectory=/opt/accord/next/current/app
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=@PORT@
ExecStart=/opt/accord/next/current/node --max-old-space-size=192 /opt/accord/next/current/app/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/var/lib/accord /var/backups/accord /var/backups/accord-web /etc/accord
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=64
MemoryHigh=256M
MemoryMax=320M
CPUQuota=50%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
